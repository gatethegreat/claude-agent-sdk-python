# ===========================================
# REQUIRED - Claude API
# ===========================================
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ===========================================
# OPTIONAL - Google Sheets Integration
# ===========================================
# Path to your Google service account JSON file
# In production, mount this as a Docker secret or volume
GOOGLE_SERVICE_ACCOUNT_JSON=/app/secrets/service-account.json
# The spreadsheet ID from your Google Sheets URL
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
# Name of the sheet containing client names
GOOGLE_SHEET_NAME=Clients

# ===========================================
# OPTIONAL - Supabase/PostgreSQL (for RAG)
# ===========================================
# Your Supabase database connection string
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ===========================================
# OPTIONAL - OpenAI (for embeddings)
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key

# ===========================================
# OPTIONAL - PGVector Configuration
# ===========================================
PGVECTOR_TABLE_NAME=documents
PGVECTOR_CONTENT_COLUMN=content
PGVECTOR_EMBEDDING_COLUMN=embedding
PGVECTOR_METADATA_COLUMN=metadata

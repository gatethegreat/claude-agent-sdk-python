# ===========================================
# REQUIRED - Database connection
# ===========================================
SUPABASE_DB_URL=postgresql://user:password@host:5432/database

# ===========================================
# REQUIRED - OpenAI API key for embeddings
# ===========================================
OPENAI_API_KEY=sk-...

# ===========================================
# REQUIRED - Google Sheets (for client lookup)
# ===========================================
# JSON content, base64-encoded JSON, or path to service account file
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
# The spreadsheet ID from your Google Sheets URL
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
# Name of the sheet containing client names
GOOGLE_SHEET_NAME=Clients

# ===========================================
# OPTIONAL - Custom table names (defaults shown)
# ===========================================
PGVECTOR_TABLE_NAME=documents
APPROVED_COPY_TABLE_NAME=approved_copy
PGVECTOR_CONTENT_COLUMN=content
PGVECTOR_EMBEDDING_COLUMN=embedding
PGVECTOR_METADATA_COLUMN=metadata
